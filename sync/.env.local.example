# Copie este arquivo para ".env.local" (nesta mesma pasta) e preencha.
# O .env.local NUNCA vai pro git nem pro site — fica só neste computador.

# 1) Entre na sua conta em https://www.playstation.com (no navegador)
# 2) Na mesma aba, abra: https://ca.account.sony.com/api/v1/ssocookie
# 3) Copie o valor de "npsso" (64 caracteres) e cole abaixo, sem aspas:
PSN_NPSSO=

# Opcional (notas, datas de lançamento e "hype"): chave grátis em https://rawg.io/apidocs
RAWG_API_KEY=

# Opcional (tempo pra zerar): app grátis em https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
